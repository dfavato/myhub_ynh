#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# SAVE SETTINGS
#=================================================

city_name=$(ynh_app_setting_get --key=city_name)
api_football_key=$(ynh_app_setting_get --key=api_football_key)

#=================================================
# RESOLVE CITY → COORDINATES
#=================================================

ynh_script_progression "Resolving coordinates for city: $city_name..."

geo_response=$(curl -sf "${OPEN_METEO_GEOCODING_URL}?name=$(python3 -c "import urllib.parse; print(urllib.parse.quote('$city_name'))")&count=1&language=en")

if [ -z "$geo_response" ] || [ "$(echo "$geo_response" | jq -r '.results | length')" = "0" ]; then
    ynh_die "Could not find coordinates for city '$city_name'. Please check the city name and reinstall."
fi

city_lat=$(echo "$geo_response" | jq -r '.results[0].latitude')
city_lon=$(echo "$geo_response" | jq -r '.results[0].longitude')
resolved_name=$(echo "$geo_response" | jq -r '.results[0].name')

ynh_app_setting_set --key=city_lat --value="$city_lat"
ynh_app_setting_set --key=city_lon --value="$city_lon"
ynh_app_setting_set --key=city_resolved_name --value="$resolved_name"

ynh_script_progression "Resolved: $resolved_name ($city_lat, $city_lon)"

#=================================================
# SETUP DIRECTORIES
#=================================================

ynh_script_progression "Creating data directories..."

mkdir -p "$myhub_data_dir/weather/summaries"
mkdir -p "$myhub_data_dir/sports/$CRUZEIRO_TEAM_ID"
mkdir -p "$myhub_data_dir/sports/$SELECAO_TEAM_ID"

chown -R "$app:$app" "$myhub_data_dir"

#=================================================
# INSTALL SYSTEMD TIMER + SERVICE
#=================================================

ynh_script_progression "Setting up systemd timer..."

ynh_config_add --template="myhub-generate.service" \
    --destination="/etc/systemd/system/${app}-generate.service"
ynh_config_add --template="myhub-generate.timer" \
    --destination="/etc/systemd/system/${app}-generate.timer"

chown root:root "/etc/systemd/system/${app}-generate.service" "/etc/systemd/system/${app}-generate.timer"
chmod 644 "/etc/systemd/system/${app}-generate.service" "/etc/systemd/system/${app}-generate.timer"

systemctl daemon-reload
systemctl enable "${app}-generate.timer"
systemctl start "${app}-generate.timer"

#=================================================
# SETUP NGINX
#=================================================

ynh_script_progression "Configuring NGINX..."

ynh_config_add_nginx

#=================================================
# RUN INITIAL GENERATION
#=================================================

ynh_script_progression "Running initial dashboard generation..."

chmod +x "$install_dir/generate.sh"
sudo -u "$app" "$install_dir/generate.sh"

#=================================================
# DONE
#=================================================

ynh_script_progression "Installation of $app completed"
