#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD TIMER
#=================================================

ynh_script_progression "Stopping systemd timer..."
systemctl stop "${app}-generate.timer" 2>/dev/null || true

#=================================================
# UPDATE NGINX CONFIG
#=================================================

ynh_script_progression "Updating NGINX configuration..."
ynh_config_add_nginx

#=================================================
# UPDATE SYSTEMD TIMER
#=================================================

ynh_script_progression "Updating systemd timer..."
ynh_config_add --template="myhub-generate.service" \
    --destination="/etc/systemd/system/${app}-generate.service"
ynh_config_add --template="myhub-generate.timer" \
    --destination="/etc/systemd/system/${app}-generate.timer"
chmod 644 "/etc/systemd/system/${app}-generate.service" "/etc/systemd/system/${app}-generate.timer"
systemctl daemon-reload

#=================================================
# UPDATE generate.sh
#=================================================

ynh_script_progression "Updating generate.sh..."
chmod +x "$install_dir/generate.sh"
chown "$app:$app" "$install_dir/generate.sh"

#=================================================
# RESTART TIMER
#=================================================

ynh_script_progression "Restarting timer..."
systemctl enable "${app}-generate.timer"
systemctl start "${app}-generate.timer"

#=================================================
# RUN GENERATION
#=================================================

ynh_script_progression "Running dashboard generation..."
sudo -u "$app" "$install_dir/generate.sh"

ynh_script_progression "Upgrade of $app completed"
